# ============================================================
# SmartDashboard — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# ─────────────────────────────────────────────
# 🗄️ Database (SQL Server)
# ─────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=SmartDashboard
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password

# ─────────────────────────────────────────────
# 🔐 Authentication
# ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your_64_char_hex_secret_here

# ─────────────────────────────────────────────
# 🌐 Server / CORS
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
APP_URL=http://localhost:5000

# ─────────────────────────────────────────────
# 🧠 ML Service
# ─────────────────────────────────────────────
ML_SERVICE_URL=http://127.0.0.1:8000/predict

# ─────────────────────────────────────────────
# 📨 MQTT Broker
# ─────────────────────────────────────────────
MQTT_BROKER_URL=mqtt://localhost:1883

# ─────────────────────────────────────────────
# 🎨 Frontend (React) — must be prefixed REACT_APP_
# ─────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_URL_KEY=http://localhost:1300

# ─────────────────────────────────────────────
# 🤖 AI Providers
# ─────────────────────────────────────────────
# Google Gemini
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
# AI_MODEL=anthropic/claude-3-haiku
# AI_MODEL=openai/gpt-3.5-turbo
# AI_MODEL=meta-llama/llama-3-8b-instruct
# AI_MODEL=google/gemini-1.5-flash

# ─────────────────────────────────────────────
# 🔗 IBM Maximo Integration
# ─────────────────────────────────────────────
MAXIMO_BASE_URL=http://your-maximo-instance:9080/maximo
MAXIMO_API_KEY=your_maximo_api_key
MAXIMO_SITE_ID=YOUR_SITE_ID
MAXIMO_TIMEOUT_MS=8000
MAXIMO_USE_PLACEHOLDER_ASSETS=true
MAXIMO_AUTO_CREATE_ASSETS=true

# ─────────────────────────────────────────────
# 📧 SMTP (Email Notifications)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_SECURE=false
SMTP_FROM=noreply@yourdomain.com
